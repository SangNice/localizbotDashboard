<Window x:Class="LocalizbotDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalizBot - RViz2 SLAM &amp; Teleop Control Station" 
        Height="760" Width="1280"
        Background="#18181B" Foreground="#F4F4F5"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp" Focusable="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Cột Bản đồ SLAM giống RViz -->
            <ColumnDefinition Width="*"/>
            <!-- Cột Bảng điều khiển & Thông số -->
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== KHU VỰC 1: BẢN ĐỒ SLAM (RVIZ VIEWPORT) ==================== -->
        <Border Grid.Column="0" Background="#09090B" Margin="10" CornerRadius="8" BorderBrush="#27272A" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <!-- Khung nhận sự kiện chuột để Zoom và Pan bản đồ -->
                <Grid x:Name="MapViewport" Background="Transparent"
                      MouseWheel="MapViewport_MouseWheel"
                      MouseLeftButtonDown="MapViewport_MouseLeftButtonDown"
                      MouseLeftButtonUp="MapViewport_MouseLeftButtonUp"
                      MouseMove="MapViewport_MouseMove">

                    <!-- Canvas gốc chứa cả Bản đồ và Robot (tự động Zoom/Pan cùng nhau) -->
                    <Canvas x:Name="WorldCanvas" Width="2000" Height="2000" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="MapScale" ScaleX="1.0" ScaleY="1.0" CenterX="1000" CenterY="1000"/>
                                <TranslateTransform x:Name="MapTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>

                        <!-- Lớp 1: Ảnh bản đồ OccupancyGrid (/map từ slam_toolbox) -->
                        <Image x:Name="SlamMapImage" RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                        <!-- Lớp 2: Gốc tọa độ Odom/Map (Trục Đỏ = X, Xanh lá = Y chuẩn ROS) -->
                        <Line X1="1000" Y1="1000" X2="1040" Y2="1000" Stroke="#EF4444" StrokeThickness="2"/>
                        <Line X1="1000" Y1="1000" X2="1000" Y2="960" Stroke="#22C55E" StrokeThickness="2"/>

                        <!-- Lớp 3: Quỹ đạo xe đã đi qua (Trajectory Path) -->
                        <Polyline x:Name="TrajectoryLine" Stroke="#38BDF8" StrokeThickness="1.5" StrokeDashArray="2,2" Opacity="0.8"/>

                        <!-- Lớp 4: Hình dáng Robot (4 bánh Skid-Steer + Mũi tên hướng Yaw) -->
                        <Canvas x:Name="RobotMarker" Canvas.Left="1000" Canvas.Top="1000" Width="0" Height="0">
                            <Canvas.RenderTransform>
                                <RotateTransform x:Name="RobotRotation" Angle="0"/>
                            </Canvas.RenderTransform>
                            <!-- Thân xe (Tâm tại 0,0) -->
                            <Rectangle Width="28" Height="22" Canvas.Left="-14" Canvas.Top="-11" 
                                       Fill="#2563EB" Stroke="#93C5FD" StrokeThickness="1.5" RadiusX="3" RadiusY="3"/>
                            <!-- Mũi tên chỉ hướng phía trước (Trục +X của Robot) -->
                            <Polygon Points="16,0 4,-7 4,7" Fill="#FACC15" Stroke="#FEF08A" StrokeThickness="1"/>
                        </Canvas>
                    </Canvas>
                </Grid>

                <!-- Thanh trạng thái nổi góc trên bên trái của Map -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" 
                        Background="#CC18181B" Padding="12,8" CornerRadius="6" BorderBrush="#3F3F46" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="SLAM MAP VIEW (OCCUPANCY GRID)" FontWeight="Bold" Foreground="#38BDF8" FontSize="12"/>
                        <TextBlock x:Name="TxtMapInfo" Text="Chưa nhận dữ liệu /map..." Foreground="#A1A1AA" FontSize="11" Margin="0,3,0,0"/>
                        <TextBlock Text="Chuột phải/Lăn chuột: Zoom | Kéo chuột trái: Pan" Foreground="#71717A" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Nút Reset góc nhìn Camera -->
                <Button Content="Căn giữa Bản đồ" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14"
                        Padding="10,5" Background="#27272A" Foreground="White" BorderBrush="#3F3F46"
                        Click="BtnResetView_Click"/>
            </Grid>
        </Border>

        <!-- ==================== KHU VỰC 2: BẢNG ĐIỀU KHIỂN & GIÁM SÁT ==================== -->
        <Border Grid.Column="1" Background="#1F1F23" Margin="0,10,10,10" CornerRadius="8" BorderBrush="#27272A" BorderThickness="1" Padding="16">
            <StackPanel>
                <!-- 1. KẾT NỐI ROSBRIDGE -->
                <TextBlock Text="1. KẾT NỐI ROS 2 (ROSBRIDGE)" FontWeight="Bold" Foreground="#38BDF8" FontSize="13"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="105"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtRosUrl" Text="ws://localhost:9090" 
                             Background="#09090B" Foreground="White" BorderBrush="#3F3F46" Padding="8,6" VerticalContentAlignment="Center"/>
                    <Button x:Name="BtnConnect" Grid.Column="1" Content="Kết nối" Margin="8,0,0,0"
                            Background="#16A34A" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Click="BtnConnect_Click"/>
                </Grid>
                <TextBlock x:Name="TxtConnStatus" Text="● Trạng thái: Đang ngắt kết nối" Foreground="#EF4444" FontSize="12" Margin="0,6,0,14"/>

                <Separator Background="#27272A" Margin="0,0,0,12"/>

                <!-- 2. GIÁM SÁT VỊ TRÍ & CẢM BIẾN (ODOMETRY + EKF + IMU + HC-SR04) -->
                <TextBlock Text="2. VỊ TRÍ XE (EKF ODOM) &amp; CẢM BIẾN" FontWeight="Bold" Foreground="#38BDF8" FontSize="13" Margin="0,0,0,8"/>

                <UniformGrid Columns="2" Rows="3" Margin="0,0,0,12">
                    <Border Background="#09090B" CornerRadius="6" Padding="10,8" Margin="0,0,4,8" BorderBrush="#27272A" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Tọa độ X (m)" Foreground="#A1A1AA" FontSize="11"/>
                            <TextBlock x:Name="TxtPosX" Text="0.000" Foreground="#F4F4F5" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#09090B" CornerRadius="6" Padding="10,8" Margin="4,0,0,8" BorderBrush="#27272A" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Tọa độ Y (m)" Foreground="#A1A1AA" FontSize="11"/>
                            <TextBlock x:Name="TxtPosY" Text="0.000" Foreground="#F4F4F5" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#09090B" CornerRadius="6" Padding="10,8" Margin="0,0,4,8" BorderBrush="#27272A" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Góc hướng Yaw (°)" Foreground="#A1A1AA" FontSize="11"/>
                            <TextBlock x:Name="TxtYaw" Text="0.0°" Foreground="#FACC15" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#09090B" CornerRadius="6" Padding="10,8" Margin="4,0,0,8" BorderBrush="#27272A" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Vận tốc dài Vx (m/s)" Foreground="#A1A1AA" FontSize="11"/>
                            <TextBlock x:Name="TxtVelLinear" Text="0.00" Foreground="#4ADE80" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#09090B" CornerRadius="6" Padding="10,8" Margin="0,0,4,0" BorderBrush="#27272A" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="MPU6050 Gyro Z (rad/s)" Foreground="#A1A1AA" FontSize="11"/>
                            <TextBlock x:Name="TxtImuGz" Text="0.000" Foreground="#38BDF8" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#09090B" CornerRadius="6" Padding="10,8" Margin="4,0,0,0" BorderBrush="#27272A" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Siêu âm HC-SR04 (m)" Foreground="#A1A1AA" FontSize="11"/>
                            <TextBlock x:Name="TxtUltrasonic" Text="-- m" Foreground="#FB923C" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Separator Background="#27272A" Margin="0,0,0,12"/>

                <!-- 3. ĐIỀU KHIỂN CHUYỂN ĐỘNG (TELEOP CMD_VEL) -->
                <TextBlock Text="3. ĐIỀU KHIỂN DI CHUYỂN (TELEOP)" FontWeight="Bold" Foreground="#38BDF8" FontSize="13" Margin="0,0,0,8"/>

                <!-- Thanh trượt chỉnh tốc độ -->
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Tốc độ tiến (m/s):" Width="125" Foreground="#D4D4D8"/>
                    <TextBlock Text="{Binding ElementName=SliderLinear, Path=Value, StringFormat={}{0:F2}}" Width="40" DockPanel.Dock="Right" TextAlignment="Right" FontWeight="Bold"/>
                    <Slider x:Name="SliderLinear" Minimum="0.05" Maximum="1.0" Value="0.25" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,14">
                    <TextBlock Text="Tốc độ xoay (rad/s):" Width="125" Foreground="#D4D4D8"/>
                    <TextBlock Text="{Binding ElementName=SliderAngular, Path=Value, StringFormat={}{0:F2}}" Width="40" DockPanel.Dock="Right" TextAlignment="Right" FontWeight="Bold"/>
                    <Slider x:Name="SliderAngular" Minimum="0.1" Maximum="2.5" Value="0.80" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                </DockPanel>

                <!-- Cụm nút nhấn D-Pad Điều khiển Robot -->
                <Grid Width="240" Height="180" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Nút Tiến (W) -->
                    <Button Grid.Row="0" Grid.Column="1" Content="▲&#x0a;TIẾN (W)" Margin="4"
                            Background="#27272A" Foreground="White" FontWeight="Bold" FontSize="11"
                            PreviewMouseLeftButtonDown="BtnForward_Down" PreviewMouseLeftButtonUp="BtnMove_Up"/>

                    <!-- Nút Quay Trái (A) -->
                    <Button Grid.Row="1" Grid.Column="0" Content="◄&#x0a;TRÁI (A)" Margin="4"
                            Background="#27272A" Foreground="White" FontWeight="Bold" FontSize="11"
                            PreviewMouseLeftButtonDown="BtnLeft_Down" PreviewMouseLeftButtonUp="BtnMove_Up"/>

                    <!-- Nút Dừng Khẩn Cấp (Space) -->
                    <Button Grid.Row="1" Grid.Column="1" Content="■&#x0a;DỪNG" Margin="4"
                            Background="#DC2626" Foreground="White" FontWeight="Bold" FontSize="12"
                            Click="BtnStop_Click"/>

                    <!-- Nút Quay Phải (D) -->
                    <Button Grid.Row="1" Grid.Column="2" Content="►&#x0a;PHẢI (D)" Margin="4"
                            Background="#27272A" Foreground="White" FontWeight="Bold" FontSize="11"
                            PreviewMouseLeftButtonDown="BtnRight_Down" PreviewMouseLeftButtonUp="BtnMove_Up"/>

                    <!-- Nút Lùi (S) -->
                    <Button Grid.Row="2" Grid.Column="1" Content="▼&#x0a;LÙI (S)" Margin="4"
                            Background="#27272A" Foreground="White" FontWeight="Bold" FontSize="11"
                            PreviewMouseLeftButtonDown="BtnBackward_Down" PreviewMouseLeftButtonUp="BtnMove_Up"/>
                </Grid>

                <Button Content="Xóa vệt quỹ đạo trên Map" Margin="0,12,0,0" Padding="6"
                        Background="#27272A" Foreground="#D4D4D8" BorderBrush="#3F3F46" Click="BtnClearTrail_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
